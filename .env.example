# Copy to .env and fill in. Everything prefixed with EXPO_PUBLIC_ is inlined
# into the JS bundle — never put secrets (mnemonics, private keys) here.

# Optional RPC overrides. When empty, the public RPCs from viem/chains are used.
EXPO_PUBLIC_RPC_AMOY=
EXPO_PUBLIC_RPC_POLYGON=

# Address of our MockUSDT (ERC-20, 6 decimals) deployed on Amoy. See docs/ (phase 5).
EXPO_PUBLIC_USDT_AMOY=

# Etherscan API V2 key (one key for all chains) — used for transaction history.
EXPO_PUBLIC_ETHERSCAN_KEY=
